# Copy to `.env`. Vite inlines every VITE_* variable into the bundle, so
# nothing secret may live here. Firebase web config is public by design — it
# identifies the project, it does not authorise anything. What actually gates
# this console is the `admin` custom claim on the signed-in account, checked
# both here and again by requireAdmin on the server.

# Where the Express API lives. Same server the Expo app talks to.
VITE_API_URL=http://localhost:8080

# Local design preview only. Production builds always use the API.
VITE_SAMPLE_DATA=false

# Firebase web config — from src/config/firebaseClient.ts in the app.
VITE_FIREBASE_API_KEY=AIzaSyB8gITvvAaTufQHvyj6v6pF8BxlVCP8088
VITE_FIREBASE_AUTH_DOMAIN=panzi-c2830.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=panzi-c2830
VITE_FIREBASE_STORAGE_BUCKET=panzi-c2830.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=860455272099
VITE_FIREBASE_APP_ID=1:860455272099:web:e1d77f527c887b135c0916

# Local dev only. Lets you open the console before any account carries the
# admin claim. Ignored by anything vite build produces, so a deployed bundle
# always asks for an admin sign-in.
VITE_SKIP_AUTH=false
