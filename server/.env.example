# Copy this file to `.env` and fill in the real values. `.env` is gitignored;
# never commit it, and never paste these values into a chat or a source file.

# From console.anthropic.com. Pays for every scan.
ANTHROPIC_API_KEY=

# The Firebase project whose login tokens this server will trust. Token
# verification needs nothing more than this — it checks the signature against
# Google's public keys.
FIREBASE_PROJECT_ID=panzi-c2830

# Only needed for privileged Firebase calls, such as granting a user the admin
# custom claim. Download from Firebase console > Project settings > Service
# accounts > Generate new private key, save it as server/serviceAccount.json,
# and point this at it. Leave blank until you build the admin panel.
GOOGLE_APPLICATION_CREDENTIALS=

# Where the MongoDB Atlas cluster lives. Required for the pantry, profile, saved
# recipe, scan history and feedback routes; the scan and recipe routes hold no
# state and never touch it, so the scanner alone runs without this.
#
# Atlas > Connect > Drivers gives you the string. Add the database name before
# the query string, e.g.
#   mongodb+srv://user:pass@cluster0.abcde.mongodb.net/panzi?retryWrites=true&w=majority
# A local mongod works too: mongodb://127.0.0.1:27017/panzi
MONGODB_URI=

# Where profile photos are stored. Create a project at supabase.com, then a
# PUBLIC bucket named `avatars` under Storage. The URL is Project settings >
# Data API; the key is Project settings > API keys > service_role.
#
# The service_role key bypasses row-level security. It belongs on this server
# and nowhere else — never in the app's .env, which Expo inlines into the
# bundle every user can read.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated origins allowed to call this API from a browser. The Expo app
# is not a browser and ignores CORS entirely; this is for the admin panel.
ALLOWED_ORIGINS=http://localhost:5173

PORT=8080

# From platform.fatsecret.com > Generate/View API Keys (free tier). Powers
# the per-scanned-item macros lookup — searches FatSecret's food database by
# the item's recognized name and stores its calories/protein/carbs/fat.
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
